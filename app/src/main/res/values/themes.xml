<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: Compose drives the real UI, this is just the launch theme. -->
    <style name="Theme.TtlDownloader" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Transparent theme for the share-receiver, which shows no UI of its own. -->
    <style name="Theme.TtlDownloader.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
