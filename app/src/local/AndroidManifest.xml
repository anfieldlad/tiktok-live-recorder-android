<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cleartext exists for a backend on a private network. Local has none. -->
    <!-- Local keeps sessionid in the sessions DataStore and the WebView cookie DB.
         allowBackup="false" keeps both out of cloud backup; on Android 12+ it
         doesn't cover device-to-device transfer, so the data extraction rules
         exclude everything from both. The session never leaves the phone. -->
    <application
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/local_data_extraction_rules"
        tools:replace="android:usesCleartextTraffic,android:allowBackup" />

</manifest>
